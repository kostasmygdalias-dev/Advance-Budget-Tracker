{
  "name": "Settings",
  "type": "object",
  "properties": {
    "default_currency": {
      "type": "string",
      "default": "EUR"
    },
    "monthly_budget_total": {
      "type": "number"
    },
    "budget_per_category": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "google_sheet_id": {
      "type": "string",
      "description": "ID of the Google Sheet (in the user's own Google Drive) that stores this user's expenses, created on first connect."
    }
  }
}